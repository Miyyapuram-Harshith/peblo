# Application
APP_NAME=peblo-tv-mini
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://peblo:peblo_dev@localhost:5432/peblo
DATABASE_URL_SYNC=postgresql://peblo:peblo_dev@localhost:5432/peblo
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo_dev
POSTGRES_DB=peblo

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL_PREFIX=/storage

# R2 (production)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Publish failure injection (dev/test only)
PUBLISH_FAILURE_INJECTION=false

# Seed
SEED_ON_STARTUP=true
SEED_DATA_PATH=./data

# Demo Credentials
DEMO_ADMIN_EMAIL=admin@peblo.local
DEMO_ADMIN_PASSWORD=admin123
DEMO_EDITOR_EMAIL=editor@peblo.local
DEMO_EDITOR_PASSWORD=editor123
